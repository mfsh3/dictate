# Copy to .env only on the deployment host. Never commit the real values.
NODE_ENV=production
PORT=3000
STATE_DIR=/opt/dictate-state/dev
OPENAI_API_KEY=
AUTH_MODE=radsup
RADSUP_AUTH_URL=https://radsup.bj7r2d.de/api/auth/login
RADSUP_CA_PATH=/opt/dictate-state/dev/radsup-dev-ca.pem
# Development only. Never enable mock auth in the public stack.
MOCK_ADMIN_EMAIL=admin@example.test
MOCK_ADMIN_PASSWORD=change-me
